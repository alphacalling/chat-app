# jwt 
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# AES-256 encryption key for secrets at rest (min 32 chars)
ENCRYPTION_KEY=

# cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=